---
import BaseLayout from './BaseLayout.astro';
import { findSection } from '../data/wiki';

const metadata = { ...Astro.props, ...(Astro.props.frontmatter ?? {}) };
const { title = '문서', description = '', pathname = '/', badge = '' } = metadata;
const section = findSection(pathname);
const currentIndex = section?.entries.findIndex((entry) => entry.href === pathname) ?? -1;
const current = currentIndex >= 0 ? section?.entries[currentIndex] : undefined;
const previous = currentIndex > 0 ? section?.entries[currentIndex - 1] : undefined;
const next = section && currentIndex >= 0 && currentIndex < section.entries.length - 1 ? section.entries[currentIndex + 1] : undefined;
const related = (section?.entries ?? []).filter((entry) => entry.href !== pathname).slice(0, 3);
const image = current?.icon ? `/assets/lifecore/${current.icon}` : null;
const heroLabel = badge || section?.eyebrow || 'CHUR WORLD GUIDE';
const sectionHome = section?.eyebrow === 'COMBAT & ADVENTURE'
  ? '/combat'
  : ['LIFE CONTENTS', 'PRODUCTION', 'LIFE GUIDE'].includes(section?.eyebrow ?? '')
    ? '/life'
    : section?.eyebrow === 'SUPPORT'
      ? '/support'
      : section?.eyebrow === 'SERVER INFO'
        ? '/'
        : '/guide/basic';
---
<BaseLayout title={`${title} | 츄르월드`} description={description} pathname={pathname}>
  <div class="document-toolbar">
    <nav class="breadcrumbs" aria-label="현재 위치">
      <a href="/">홈</a>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
      <a href={sectionHome}>{section?.title ?? '위키'}</a>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
      <strong>{title}</strong>
    </nav>
    <button type="button" data-copy-page>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 8.5V6a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-2.5M6 9h7a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2Z" /></svg>
      <span>링크 복사</span>
    </button>
  </div>

  <div class="document-grid">
    <article class="doc-shell">
      <header class="doc-hero">
        <div class="doc-hero-copy">
          <span class="eyebrow"><i></i>{heroLabel}</span>
          <h1>{title}</h1>
          {description && <p class="doc-summary">{description}</p>}
          <div class="article-meta">
            <span>{section?.title ?? '서버 가이드'}</span>
            <span>유저용 안내</span>
          </div>
        </div>
        {image && <img class="doc-cover-image" src={image} alt="" />}
      </header>

      <details class="mobile-toc" id="mobileToc" hidden>
        <summary>
          <span><small>ON THIS PAGE</small><strong>이 문서에서</strong></span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg>
        </summary>
        <nav></nav>
      </details>

      <div class="doc-body" id="docContent">
        <slot />
      </div>

      <div class="doc-end">
        <span>실제 서버 설정과 다른 내용이 있다면 운영진에게 알려주세요.</span>
        <a href="/commands">명령어 모음 보기 <span aria-hidden="true">→</span></a>
      </div>

      {(previous || next) && (
        <nav class="article-footer" aria-label="이전 및 다음 문서">
          <div>
            {previous && <><small>이전 문서</small><a href={previous.href}><span aria-hidden="true">←</span> {previous.title}</a></>}
          </div>
          <div>
            {next && <><small>다음 문서</small><a href={next.href}>{next.title} <span aria-hidden="true">→</span></a></>}
          </div>
        </nav>
      )}
    </article>

    <aside class="page-outline" aria-label="문서 보조 탐색">
      <div class="page-toc" id="pageToc" hidden>
        <span>ON THIS PAGE</span>
        <strong>이 문서에서</strong>
        <nav></nav>
      </div>
      {related.length > 0 && (
        <div class="related-card">
          <span>RELATED</span>
          <strong>함께 보면 좋아요</strong>
          {related.map((entry) => <a href={entry.href}>{entry.title}<span aria-hidden="true">→</span></a>)}
        </div>
      )}
    </aside>
  </div>

  <script>
    const content = document.querySelector('#docContent');
    const desktopToc = document.querySelector('#pageToc');
    const mobileToc = document.querySelector('#mobileToc');
    const desktopNav = desktopToc?.querySelector('nav');
    const mobileNav = mobileToc?.querySelector('nav');
    const headings = content ? [...content.querySelectorAll('h2, h3, h4')] : [];

    function createTocLink(heading) {
      const link = document.createElement('a');
      link.href = `#${heading.id}`;
      link.textContent = heading.textContent ?? '';
      if (heading.tagName === 'H3') link.className = 'depth-3';
      if (heading.tagName === 'H4') link.className = 'depth-4';
      return link;
    }

    if (desktopToc instanceof HTMLElement && mobileToc instanceof HTMLElement && desktopNav && mobileNav && headings.length > 1) {
      headings.forEach((heading, index) => {
        if (!(heading instanceof HTMLElement)) return;
        if (!heading.id) heading.id = `section-${index + 1}`;
        desktopNav.appendChild(createTocLink(heading));
        mobileNav.appendChild(createTocLink(heading));
      });
      desktopToc.hidden = false;
      mobileToc.hidden = false;

      const links = [...desktopNav.querySelectorAll('a')];
      const observer = new IntersectionObserver((entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (!visible) return;
        links.forEach((link) => link.classList.toggle('active', link.getAttribute('href') === `#${visible.target.id}`));
      }, { rootMargin: '-96px 0px -70% 0px', threshold: 0 });
      headings.forEach((heading) => observer.observe(heading));
    }

    content?.querySelectorAll('table').forEach((table) => {
      if (table.parentElement?.classList.contains('table-scroll')) return;
      const wrap = document.createElement('div');
      wrap.className = 'table-scroll';
      wrap.setAttribute('tabindex', '0');
      wrap.setAttribute('role', 'region');
      wrap.setAttribute('aria-label', '좌우로 이동해 표 전체 보기');
      table.parentNode?.insertBefore(wrap, table);
      wrap.appendChild(table);
    });

    document.querySelector('[data-copy-page]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget;
      if (!(button instanceof HTMLButtonElement)) return;
      const label = button.querySelector('span');
      try {
        await navigator.clipboard.writeText(window.location.href);
        if (label) label.textContent = '복사 완료';
        setTimeout(() => { if (label) label.textContent = '링크 복사'; }, 1800);
      } catch {
        window.prompt('문서 주소를 복사하세요.', window.location.href);
      }
    });
  </script>
</BaseLayout>
