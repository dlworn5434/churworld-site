---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const guides = [
  { href: '/guide/basic/start', no: '01', title: '첫걸음 가이드', text: '디스코드 가입·인증, 전용 클라이언트 접속과 첫 직업 선택', tag: '먼저 읽기' },
  { href: '/guide/basic/tutorial', no: '02', title: '신규 유저 튜토리얼', text: '로비에서 생활 핵심 기능을 직접 체험하는 필수 과정', tag: '필수 과정' },
  { href: '/guide/basic/menu', no: '03', title: '메뉴 사용법', text: 'Shift + F 메뉴에서 워프·생활·생산·상점·편의 기능 찾기', tag: '핵심 기능' },
  { href: '/map', no: '04', title: '월드 안내', text: '스폰, 마을 1~6, 야생 1~6, 지옥과 엔더', tag: '월드' },
  { href: '/guide/basic/village', no: '05', title: '마을', text: '점유, 그룹, 멤버·손님, 조공, 주간 세금과 레벨', tag: '정착' },
  { href: '/guide/basic/construction', no: '06', title: '마을 건축', text: '건설 도면, 도구함, 장식 가구와 효과 타워 설치', tag: '정착' },
  { href: '/guide/basic/storage', no: '07', title: '자동 창고 정리', text: '투입함 만들기, 액자로 품목 분류와 자동 보관', tag: '편의' },
  { href: '/guide/basic/travel', no: '08', title: '이동과 홈', text: '개인 홈, 공개 홈, 랜덤 이동, 상점 택시와 엘리베이터', tag: '편의' },
  { href: '/guide/basic/camera', no: '09', title: '카메라와 벽 사진', text: '사진 촬영과 편집, 필름 인화, 벽 사진 설치와 관리', tag: '콘텐츠' },
  { href: '/guide/basic/bag', no: '10', title: '가방', text: '보관 공간, 확장 비용, 페이지와 자동 획득 설정', tag: '편의' },
  { href: '/guide/basic/mailbox', no: '11', title: '우편함', text: '아이템 발송 비용, 수령과 보관 한도', tag: '편의' },
  { href: '/guide/basic/shop', no: '12', title: '상점과 거래', text: '거래소, 후원상점, 생활상점과 물물교환', tag: '경제' },
  { href: '/guide/basic/marketplace', no: '13', title: '유저 거래소', text: '판매 등록, 구매 주문, 보관함과 정산', tag: '경제' },
  { href: '/guide/basic/economy', no: '14', title: '재화·교환·ATM', text: '돈 보내기, 물물교환, 작물교환과 츄르 환전', tag: '경제' },
  { href: '/guide/basic/requests', no: '15', title: '의뢰', text: '일일·주간·월간 목표와 새로고침', tag: '성장' },
  { href: '/guide/basic/codi', no: '16', title: '코디와 뽑기', text: '코디 보관함과 코디·도구·방어구 스킨 뽑기', tag: '치장' },
  { href: '/guide/basic/drawing', no: '17', title: '그림과 이젤', text: '그림 그리기, 저장과 지도 작품 만들기', tag: '콘텐츠' },
  { href: '/guide/basic/diving-chair', no: '18', title: '잠수 의자', text: '의자 사용법, 별 획득과 판매', tag: '콘텐츠' },
  { href: '/support/membership', no: '19', title: '츄르냥 멤버십', text: '등급별 홈·잠금·이동·로얄 전용 혜택', tag: '후원' }
];
---

<BaseLayout title="시작 가이드 | 츄르월드" description="츄르월드의 정착과 편의 기능을 한눈에 보는 시작 가이드" pathname="/guide/basic">
  <section class="index-hero warm-hero">
    <div><span class="kicker">START HERE</span><h1>츄르월드 시작 가이드</h1><p>처음 접속한 순간부터 마을에 정착할 때까지, 꼭 필요한 기능을 순서대로 모았습니다.</p></div>
    <div class="index-hero-side"><img src="/assets/lifecore/lifeknowledge.png" alt="" /><span><b>추천 순서</b>첫걸음 → 메뉴 → 월드 → 마을</span></div>
  </section>

  <section class="guide-index">
    <div class="section-heading"><div><span class="kicker">GUIDE INDEX</span><h2>기본 문서</h2></div><button class="section-link as-button" type="button" data-search-open>문서 검색 →</button></div>
    <div class="guide-list-grid">
      {guides.map((guide) => (
        <a class="guide-list-card" href={guide.href}>
          <span class="guide-no">{guide.no}</span>
          <div><small>{guide.tag}</small><h3>{guide.title}</h3><p>{guide.text}</p></div>
          <b>→</b>
        </a>
      ))}
    </div>
  </section>

  <section class="tip-banner"><b>게임 안에서는</b><span><kbd>Shift</kbd> + <kbd>F</kbd>로 통합 메뉴를 열 수 있습니다.</span><a href="/guide/basic/menu">메뉴 자세히 보기 →</a></section>
</BaseLayout>
