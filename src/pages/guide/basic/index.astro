---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const guides = [
  { href: '/guide/basic/start', no: '01', title: '첫걸음 가이드', text: '접속, 통합 메뉴, 길라잡이와 첫 생활 선택', tag: '먼저 읽기' },
  { href: '/guide/basic/menu', no: '02', title: '메뉴 사용법', text: 'Shift + F 메뉴에서 워프·생활·상점·편의 기능 찾기', tag: '핵심 기능' },
  { href: '/map', no: '03', title: '월드 안내', text: '스폰, 마을 1~6, 야생 1~6, 지옥과 엔더', tag: '월드' },
  { href: '/guide/basic/village', no: '04', title: '마을', text: '점유, 그룹, 멤버·손님, 조공, 세금과 레벨', tag: '정착' },
  { href: '/guide/basic/travel', no: '05', title: '이동과 홈', text: '개인 홈, 공개 홈, 랜덤 이동, 뒤로 가기와 엘리베이터', tag: '편의' },
  { href: '/guide/basic/bag', no: '06', title: '가방', text: '보관 공간, 확장 비용, 페이지와 자동 획득 설정', tag: '편의' },
  { href: '/guide/basic/diving-chair', no: '07', title: '잠수 의자', text: '의자 사용법, 별 획득과 판매', tag: '콘텐츠' },
  { href: '/guide/basic/benefits', no: '08', title: '등급 혜택', text: '츄르냥 등급별 홈·잠금·편의 혜택', tag: '안내' }
];
---

<BaseLayout title="시작 가이드 | 츄르월드" description="츄르월드의 정착과 편의 기능을 한눈에 보는 시작 가이드" pathname="/guide/basic">
  <section class="index-hero warm-hero">
    <div><span class="kicker">START HERE</span><h1>츄르월드 시작 가이드</h1><p>처음 접속한 순간부터 마을에 정착할 때까지, 꼭 필요한 기능을 순서대로 모았습니다.</p></div>
    <div class="index-hero-side"><img src="/assets/lifecore/lifeknowledge.png" alt="" /><span><b>추천 순서</b>첫걸음 → 메뉴 → 월드 → 마을</span></div>
  </section>

  <section class="guide-index">
    <div class="section-heading"><div><span class="kicker">GUIDE INDEX</span><h2>기본 문서</h2></div><button class="section-link as-button" type="button" data-search-open>문서 검색 →</button></div>
    <div class="guide-list-grid">
      {guides.map((guide) => (
        <a class="guide-list-card" href={guide.href}>
          <span class="guide-no">{guide.no}</span>
          <div><small>{guide.tag}</small><h3>{guide.title}</h3><p>{guide.text}</p></div>
          <b>→</b>
        </a>
      ))}
    </div>
  </section>

  <section class="tip-banner"><b>게임 안에서는</b><span><kbd>Shift</kbd> + <kbd>F</kbd>로 통합 메뉴를 열 수 있습니다.</span><a href="/guide/basic/menu">메뉴 자세히 보기 →</a></section>
</BaseLayout>
