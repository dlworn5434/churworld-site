---
import BaseLayout from '../../layouts/BaseLayout.astro';

const lifeJobs = [
  { href: '/life/miner', title: '광부', image: 'lifemine.png', summary: '광석과 광맥을 찾아 채굴하며 보석과 핵심 재료를 모으는 생활', stats: '근로 · 지식 · 감각 · 행운', tone: 'stone' },
  { href: '/life/fisher', title: '어부', image: 'lifefish.png', summary: '미니게임을 즐기고 파츠를 조합해 더 좋은 물고기를 노리는 생활', stats: '근로 · 지식 · 감각 · 행운', tone: 'water' },
  { href: '/life/farmer', title: '농부', image: 'lifefarm.png', summary: '커스텀 작물을 키우고 높은 등급과 추가 수확을 노리는 생활', stats: '근로 · 지식 · 감각 · 행운', tone: 'field' },
  { href: '/life/woodcutter', title: '나무꾼', image: 'lifewoodcutter.png', summary: '원목과 커스텀 나무를 벌목하며 채집 효율을 키우는 생활', stats: '근로 · 지식 · 감각 · 행운', tone: 'wood' }
];

const productionJobs = [
  { href: '/life/chef', title: '요리사', image: 'lifecook.png', summary: '레시피를 익혀 실버와 골드 품질의 요리를 만드는 생산', stats: '근로 · 지식 · 감각 · 행운', tone: 'ember' },
  { href: '/life/blacksmith', title: '대장술', image: 'lifeblacksmith.png', summary: '대장간 화로에서 제련하고 재료 절약과 추가 제작을 노리는 생산', stats: '근로 · 지식 · 감각 · 행운', tone: 'smith' }
];

const stats = [
  { name: '근로', image: 'lifework.png', text: '작업 속도와 기본 효율' },
  { name: '지식', image: 'lifeknowledge.png', text: '성공률과 경험치 보정' },
  { name: '감각', image: 'lifesense.png', text: '반응 속도와 추가 획득' },
  { name: '행운', image: 'lifeluck.png', text: '등급과 보너스 확률' }
];
---

<BaseLayout title="생활·생산 콘텐츠 | 츄르월드" description="츄르월드 생활·생산 직업과 성장 구조 안내" pathname="/life">
  <section class="index-hero life-index-hero">
    <div><span class="kicker">LIFE &amp; PRODUCTION</span><h1>자원을 모으는 네 생활,<br />결과물을 만드는 두 생산</h1><p>생활과 생산은 공용 성장과 직업별 숙련도, 직접 투자·장비·도감·큐브 스킬 랭크가 함께 연결됩니다.</p><div class="hero-actions"><a class="btn primary" href="/life/growth">성장 구조 먼저 보기</a><a class="btn text" href="/life/faq">생활·생산 FAQ →</a></div></div>
    <div class="stat-art-stack">
      {stats.map((stat) => <div><img src={`/assets/lifecore/${stat.image}`} alt="" /><span><b>{stat.name}</b>{stat.text}</span></div>)}
    </div>
  </section>

  <section class="home-section">
    <div class="section-heading"><div><span class="kicker">CHOOSE YOUR LIFE</span><h2>생활 직업</h2><p>자주 하는 활동과 원하는 보상에 맞춰 골라보세요.</p></div></div>
    <div class="life-job-list">
      {lifeJobs.map((job, index) => (
        <a class={`life-job-row ${job.tone}`} href={job.href}>
          <span class="life-job-index">0{index + 1}</span><img src={`/assets/lifecore/${job.image}`} alt="" loading="lazy" />
          <div><small>LIFE JOB</small><h3>{job.title}</h3><p>{job.summary}</p><span>{job.stats}</span></div><b>문서 보기 →</b>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section">
    <div class="section-heading"><div><span class="kicker">PRODUCTION JOBS</span><h2>생산 직업</h2><p>모은 재료를 가공해 더 가치 있는 결과물을 만들어보세요.</p></div></div>
    <div class="life-job-list">
      {productionJobs.map((job, index) => (
        <a class={`life-job-row ${job.tone}`} href={job.href}>
          <span class="life-job-index">0{index + 5}</span><img src={`/assets/lifecore/${job.image}`} alt="" loading="lazy" />
          <div><small>PRODUCTION JOB</small><h3>{job.title}</h3><p>{job.summary}</p><span>{job.stats}</span></div><b>문서 보기 →</b>
        </a>
      ))}
    </div>
  </section>

  <section class="life-resource-grid">
    <a href="/life/growth"><span>성장</span><h3>공용 레벨과 스탯</h3><p>숙련도, 스탯 투자 화면과 직업별 적용 범위를 정리했습니다.</p><b>성장 구조 보기 →</b></a>
    <a href="/life/recipes"><span>제작</span><h3>생활 제작법</h3><p>작업대, 농사 장비, 큐브와 드라코라이트 방어구의 실제 재료를 확인하세요.</p><b>제작법 보기 →</b></a>
    <a href="/life/equipment"><span>장비</span><h3>드라코라이트·강화·큐브</h3><p>소유권 각인, 기본 스탯, +10 별 강화와 잠재능력 큐브를 정리했습니다.</p><b>장비 성장 보기 →</b></a>
    <a href="/life/codex"><span>수집</span><h3>생활 도감</h3><p>생활·생존·기타·방어구 8개 분류의 등록 조건과 영구 보상을 확인하세요.</p><b>도감 보기 →</b></a>
    <a href="/guide/basic/construction"><span>정착</span><h3>마을 건축</h3><p>건설 도면과 도구함으로 장식 가구와 효과 타워를 설치하는 방법을 확인하세요.</p><b>마을 건축 보기 →</b></a>
    <a href="/life/systems"><span>안내</span><h3>주요 시스템 한눈에 보기</h3><p>스킬 랭크, 지역 활력, 생활 조각, 장비 성장과 의뢰의 연결 구조를 확인하세요.</p><b>시스템 보기 →</b></a>
    <a href="/life/faq"><span>도움말</span><h3>생활·생산 FAQ</h3><p>숙련도와 파츠, 작물, 나무꾼과 대장술에 관한 자주 묻는 질문입니다.</p><b>FAQ 보기 →</b></a>
  </section>
</BaseLayout>
