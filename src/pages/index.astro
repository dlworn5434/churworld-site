---
import BaseLayout from '../layouts/BaseLayout.astro';

const startSteps = [
  { no: '01', title: '튜토리얼 완료하기', text: '신규 유저는 로비에서 농사·채광·벌목·낚시의 기본 조작을 먼저 체험합니다.', href: '/guide/basic/tutorial' },
  { no: '02', title: '통합 메뉴 열기', text: '튜토리얼을 마친 뒤 Shift + F로 워프, 생활·생산, 가방과 상점을 확인하세요.', href: '/guide/basic/menu' },
  { no: '03', title: '직업 하나 골라보기', text: '생활 4종과 생산 2종 중 마음에 드는 직업부터 시작하세요.', href: '/life' }
];

const jobs = [
  { category: '생활', title: '광부', text: '바닐라 광석과 커스텀 광맥을 채굴하고 보석과 재료를 모읍니다.', href: '/life/miner', image: 'lifemine.png', color: 'stone' },
  { category: '생활', title: '어부', text: '낚시 미니게임과 장비 파츠, 등급 물고기를 함께 성장시킵니다.', href: '/life/fisher', image: 'lifefish.png', color: 'water' },
  { category: '생활', title: '농부', text: '커스텀 작물을 기르고 수확 등급과 반복 효율을 높입니다.', href: '/life/farmer', image: 'lifefarm.png', color: 'field' },
  { category: '생활', title: '나무꾼', text: '원목과 커스텀 나무를 벌목하고 도끼와 채집 효율을 성장시킵니다.', href: '/life/woodcutter', image: 'lifewoodcutter.png', color: 'wood' },
  { category: '생산', title: '요리사', text: '재료를 조리해 노멀·실버·골드 등급의 요리를 완성합니다.', href: '/life/chef', image: 'lifecook.png', color: 'ember' },
  { category: '생산', title: '대장술', text: '대장간 화로에서 제련하고 재료 절약과 추가 제작을 노립니다.', href: '/life/blacksmith', image: 'lifeblacksmith.png', color: 'smith' }
];

const heroJobs = jobs.filter((job) => job.category === '생활');

const wikiCards = [
  { title: '마을과 정착', text: '점유, 그룹, 손님, 조공, 세금, 레벨과 마을 비행', href: '/guide/basic/village', label: '정착' },
  { title: '월드와 이동', text: '마을·야생 월드, 홈, 공개 홈, 랜덤 이동과 엘리베이터', href: '/map', label: '이동' },
  { title: '가방과 편의', text: '가방 확장과 자동 수집, 통합 메뉴의 편의 기능', href: '/guide/basic/bag', label: '편의' },
  { title: '상점과 경제', text: '생활·후원상점, 추천 거래소, 물물교환과 츄르 ATM', href: '/guide/basic/shop', label: '경제' },
  { title: '코디와 즐길거리', text: '코디·도구 스킨 뽑기, 그림 이젤, 잠수 의자와 의뢰', href: '/guide/basic/codi', label: '콘텐츠' },
  { title: '후원과 멤버십', text: '츄르냥 등급별 홈·잠금·이동·로얄 전용 혜택', href: '/support', label: '후원' },
  { title: '서버 이용 안내', text: '자주 쓰는 명령어, 규칙, 공지와 이용 약관', href: '/commands', label: '안내' }
];
---

<BaseLayout title="츄르월드 위키" description="츄르월드의 생활·생산, 마을, 월드와 편의 기능을 정리한 공식 위키" pathname="/">
  <section class="home-hero">
    <div class="home-hero-copy">
      <span class="kicker">CHUR WORLD · MINECRAFT 1.21.4+</span>
      <h1>느긋하게 정착하고,<br /><em>나만의 생활</em>을<span class="mobile-break"><br /></span> 만들어 보세요.</h1>
      <p class="lead">마을을 만들고, 자원을 모으고, 네 생활 직업과 두 생산 직업을 키우는 츄르월드. 필요한 정보는 이 위키에서 빠르게 찾아볼 수 있습니다.</p>

      <div class="server-address">
        <div><small>SERVER ADDRESS</small><strong>churworld.kr</strong></div>
        <button type="button" id="copyBtn">주소 복사</button>
      </div>
      <p class="client-note">게임 접속은 츄르월드 전용 클라이언트를 이용해 주세요.</p>
      <div class="hero-actions">
        <a class="btn primary" href="/guide/basic/start#전용-클라이언트로-접속하기">전용 클라이언트 안내</a>
        <a class="btn text" href="https://discord.gg/bSFpbtpvKE" target="_blank" rel="noreferrer">디스코드 참여 →</a>
      </div>
    </div>

    <div class="hero-art" aria-label="츄르월드 생활 직업 아이콘">
      <div class="hero-art-heading">
        <span>오늘은 어떤 생활을 할까요?</span>
        <span class="live-state"><i id="statusDot"></i><b id="statusText">상태 확인 중</b></span>
      </div>
      <div class="hero-art-grid">
        {heroJobs.map((job) => (
          <a href={job.href} class={`art-tile ${job.color}`} aria-label={`${job.title} 문서 보기`}>
            <img src={`/assets/lifecore/${job.image}`} alt="" />
            <strong>{job.title}</strong>
          </a>
        ))}
      </div>
      <div class="hero-art-note"><span>공용 레벨</span><b>생활과 생산 활동을 할수록 함께 성장합니다</b></div>
    </div>
  </section>

  <section class="fact-strip" aria-label="서버 핵심 정보">
    <div><strong>1.21.4+</strong><span>서버 버전</span></div>
    <div><strong>4 + 2</strong><span>생활 · 생산 직업</span></div>
    <div><strong>6개</strong><span>야생·마을 월드</span></div>
    <div><strong>Shift + F</strong><span>통합 메뉴</span></div>
  </section>

  <section class="home-section start-section">
    <div class="section-heading">
      <div><span class="kicker">QUICK START</span><h2>처음이라면 여기부터</h2></div>
      <a href="/guide/basic" class="section-link">시작 가이드 전체 보기 →</a>
    </div>
    <div class="start-grid">
      {startSteps.map((step) => (
        <a href={step.href} class="start-card">
          <span>{step.no}</span>
          <div><h3>{step.title}</h3><p>{step.text}</p></div>
          <i>→</i>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section life-showcase">
    <div class="section-heading">
      <div><span class="kicker">LIFE &amp; PRODUCTION</span><h2>생활과 생산은 취향대로</h2><p>자원을 모으는 생활과 결과물을 만드는 생산을 원하는 방식으로 키워보세요.</p></div>
      <a href="/life" class="section-link">생활·생산 콘텐츠 전체 보기 →</a>
    </div>
    <div class="job-grid">
      {jobs.map((job) => (
        <a href={job.href} class={`job-card ${job.color}`}>
          <img src={`/assets/lifecore/${job.image}`} alt="" loading="lazy" />
          <div><span>{job.category} 직업</span><h3>{job.title}</h3><p>{job.text}</p><b>자세히 보기 →</b></div>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section">
    <div class="section-heading">
      <div><span class="kicker">WIKI CATEGORIES</span><h2>필요한 정보만 빠르게</h2></div>
      <div class="section-actions">
        <button class="section-link as-button" type="button" data-catalog-open aria-controls="wikiCatalog" aria-expanded="false">전체 목차 보기 →</button>
        <button class="section-link as-button" type="button" data-search-open>문서 검색 →</button>
      </div>
    </div>
    <div class="wiki-card-grid">
      {wikiCards.map((card) => (
        <a href={card.href} class="wiki-card">
          <span>{card.label}</span><h3>{card.title}</h3><p>{card.text}</p><b>문서 열기 →</b>
        </a>
      ))}
    </div>
  </section>

  <section class="home-callout">
    <div><span class="kicker">PLAY TOGETHER</span><h2>츄르월드에서 만나요.</h2><p>공식 디스코드에서 전용 클라이언트를 준비한 뒤 접속해 주세요.</p></div>
    <div><code>churworld.kr</code><button type="button" data-copy-address>복사</button></div>
  </section>

  <script>
    const address = 'churworld.kr';
    const copyButtons = [document.querySelector('#copyBtn'), document.querySelector('[data-copy-address]')];
    copyButtons.forEach((button) => button?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(address);
        const previous = button.textContent;
        button.textContent = '복사 완료';
        setTimeout(() => button.textContent = previous, 1500);
      } catch {
        window.prompt('서버 주소를 복사하세요.', address);
      }
    }));

    const dot = document.querySelector('#statusDot');
    const status = document.querySelector('#statusText');
    fetch(`https://api.mcsrvstat.us/2/${address}`)
      .then((response) => response.json())
      .then((data) => {
        if (data.online) {
          dot?.classList.add('online');
          if (status) status.textContent = `${data.players?.online ?? 0}명 접속 중`;
        } else if (status) status.textContent = '현재 오프라인';
      })
      .catch(() => { if (status) status.textContent = 'churworld.kr'; });
  </script>
</BaseLayout>
