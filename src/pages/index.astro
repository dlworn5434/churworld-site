---
import BaseLayout from '../layouts/BaseLayout.astro';

const jobs = [
  { title: '광부', description: '광맥을 발견하고 희귀 재료를 모아요', href: '/life/miner', image: 'lifemine.png', tone: 'mine' },
  { title: '어부', description: '미니게임과 파츠로 손맛을 키워요', href: '/life/fisher', image: 'lifefish.png', tone: 'fish' },
  { title: '농부', description: '작물과 농사 시설을 관리해요', href: '/life/farmer', image: 'lifefarm.png', tone: 'farm' },
  { title: '나무꾼', description: '고목과 지역 활력을 활용해요', href: '/life/woodcutter', image: 'lifewoodcutter.png', tone: 'wood' },
  { title: '요리사', description: '재료를 조리해 등급 요리를 만들어요', href: '/life/chef', image: 'lifecook.png', tone: 'cook' },
  { title: '대장술', description: '제련과 제작으로 장비 재료를 만들어요', href: '/life/blacksmith', image: 'lifeblacksmith.png', tone: 'smith' }
];

const quickGuides = [
  { label: '정착', title: '마을 만들고 점유하기', meta: '생성 · 청크 · 권한', icon: 'settlement', href: '/guide/basic/village' },
  { label: '성장', title: '생활 스킬과 스탯', meta: '랭크 · 포인트 · 활력', icon: 'growth', href: '/life/growth' },
  { label: '장비', title: '강화와 큐브 파츠', meta: '각인 · 강화 · 잠재', icon: 'equipment', href: '/life/equipment' },
  { label: '규칙', title: '꼭 지켜야 할 이용 규칙', meta: '금지 행동 · 경고 · 신고', icon: 'rules', href: '/rules' }
];
---

<BaseLayout title="츄르월드 위키" description="츄르월드의 생활·생산, 마을, 월드와 편의 기능을 정리한 공식 위키" pathname="/">
  <div class="home-view">
    <div class="welcome-grid">
      <section class="welcome-card">
        <div class="welcome-orbit" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="welcome-copy">
          <span class="eyebrow"><i></i>FIRST JOIN · MINECRAFT 1.21.4+</span>
          <h1>디스코드 가입부터,<br /><em>전용 클라이언트까지.</em></h1>
          <p>디스코드에 가입해 간편하게 화이트리스트(화리)를 등록하고, 츄르월드 전용 클라이언트를 다운로드해 주세요.</p>
          <p class="client-required">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 7v6M12 17h.01M12 3.5 21 20.5H3Z" /></svg>
            <strong>전용 클라이언트가 없으면 정상적인 플레이가 어렵습니다.</strong>
          </p>
          <div class="hero-actions">
            <a class="primary-action" href="https://discord.gg/9n4F7rYWVE" target="_blank" rel="noreferrer">디스코드 가입·화리 등록 <span aria-hidden="true">↗</span></a>
            <a class="secondary-action" href="/guide/basic/start">전용 클라이언트 받기 <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="welcome-art" aria-hidden="true">
          <div class="art-glow"></div>
          <img class="art-main" src="/assets/lifecore/lifeknowledge.png" alt="" />
          <span class="float-tag tag-one">DISCORD VERIFIED</span>
          <span class="float-tag tag-two">CLIENT REQUIRED</span>
        </div>
      </section>

      <aside class="server-card">
        <div class="server-card-head"><span>LIVE SERVER</span><i data-status-dot></i></div>
        <div class="server-state">
          <small>현재 서버 상태</small>
          <strong data-status-text>상태 확인 중</strong>
          <p>츄르월드 전용 클라이언트로 접속해 주세요.</p>
        </div>
        <dl>
          <div><dt>서버 주소</dt><dd>churworld.kr</dd></div>
          <div><dt>통합 메뉴</dt><dd>Shift + F</dd></div>
          <div><dt>지원 버전</dt><dd>1.21.4+</dd></div>
        </dl>
        <button type="button" data-copy-address>서버 주소 복사 <span>CTRL + C</span></button>
      </aside>
    </div>

    <section class="section-block quick-section">
      <header class="section-title">
        <div><span>QUICK ROUTES</span><h2>무엇을 하러 오셨나요?</h2></div>
        <p>기능 이름을 몰라도 목적만 고르면 됩니다.</p>
      </header>
      <div class="quick-grid">
        {quickGuides.map((guide, index) => (
          <a href={guide.href} class={`quick-card quick-${index + 1}`}>
            <span class="quick-icon">
              {guide.icon === 'settlement' && (
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 10.5 12 3.5l8.5 7M5.5 9v11h13V9M9.5 20v-6.5h5V20" /></svg>
              )}
              {guide.icon === 'growth' && (
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20V10M12 13c-3.8 0-6-2.1-6-6 3.8 0 6 2.1 6 6ZM12 10c0-3.8 2.2-6 6-6 0 3.8-2.2 6-6 6ZM6 20h12" /></svg>
              )}
              {guide.icon === 'equipment' && (
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5 19 6v5.3c0 4.2-2.5 7.2-7 9.2-4.5-2-7-5-7-9.2V6l7-2.5Zm0 5-3 3 3 3 3-3-3-3Z" /></svg>
              )}
              {guide.icon === 'rules' && (
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3.5h7L17.5 7v13.5H7ZM14 3.5V7h3.5m-8.5 4 1 1 2-2m1.5 1H16m-7 5 1 1 2-2m1.5 1H16" /></svg>
              )}
            </span>
            <div><small>{guide.label}</small><h3>{guide.title}</h3><p>{guide.meta}</p></div>
            <svg class="card-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 16 16 8M9 8h7v7" /></svg>
          </a>
        ))}
      </div>
    </section>

    <div class="content-grid">
      <section class="section-block jobs-section">
        <header class="section-title compact">
          <div><span>LIFE &amp; PRODUCTION</span><h2>내 생활을 골라보세요</h2></div>
          <a href="/life">전체 보기 <span aria-hidden="true">→</span></a>
        </header>
        <div class="home-job-grid">
          {jobs.map((job) => (
            <a href={job.href} class={`home-job-card ${job.tone}`}>
              <div class="job-image"><img src={`/assets/lifecore/${job.image}`} alt="" loading="lazy" /></div>
              <div><h3>{job.title}</h3><p>{job.description}</p></div>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
            </a>
          ))}
        </div>
      </section>

      <aside class="guide-stack">
        <section class="start-checklist">
          <header><span>FIRST LOGIN</span><h2>첫 접속 체크</h2></header>
          <ol>
            <li><span>1</span><div><strong>디스코드 가입·인증</strong><small>화이트리스트 등록</small></div></li>
            <li><span>2</span><div><strong>전용 클라이언트 설치</strong><small>정상적인 플레이에 필수</small></div></li>
            <li><span>3</span><div><strong>튜토리얼 진행</strong><small>핵심 생활 기능 체험</small></div></li>
          </ol>
          <a href="/guide/basic/start">가입 절차 자세히 보기 <span aria-hidden="true">→</span></a>
        </section>

        <section class="popular-panel">
          <header><span>MOST VIEWED</span><h2>자주 찾는 정보</h2></header>
          <a href="/guide/basic/village"><b>01</b><span>마을 점유와 권한</span><i>›</i></a>
          <a href="/life/farmer"><b>02</b><span>농사 시설 범위</span><i>›</i></a>
          <a href="/guide/basic/bag"><b>03</b><span>가방 확장 방법</span><i>›</i></a>
          <a href="/life/equipment"><b>04</b><span>큐브와 파츠</span><i>›</i></a>
        </section>
      </aside>
    </div>

    <section class="home-directory">
      <header class="section-title compact">
        <div><span>WIKI DIRECTORY</span><h2>더 둘러보기</h2></div>
        <button class="section-link as-button" type="button" data-catalog-open>전체 위키 열기 <span aria-hidden="true">→</span></button>
      </header>
      <div class="directory-grid">
        <a href="/guide/basic"><small>START</small><strong>정착과 편의</strong><span>가입부터 마을 생활까지</span></a>
        <a href="/combat"><small>ADVENTURE</small><strong>전투와 모험</strong><span>더 타워와 잔향록</span></a>
        <a href="/support"><small>SUPPORT</small><strong>후원과 멤버십</strong><span>등급별 혜택 비교</span></a>
        <a href="/map"><small>WORLD</small><strong>월드 안내</strong><span>이동 조건과 이용법</span></a>
      </div>
    </section>
  </div>

</BaseLayout>
